node_modules/
data/
.env
# Copy these into your environment (the server reads process.env, no dotenv needed):
#   set -a; source .env; set +a; npm start

PORT=3000
# Frontend origin allowed to call the API (use your site's URL in production, not *)
CORS_ORIGIN=*

# Free paper-trading credit for new accounts. Set to 0 if users should only trade what they deposit.
STARTING_USD=100000

# --- Deposits (manual bank transfer, confirmed by you) ---
DEPOSIT_BANK_ACCOUNT=0223060087462
DEPOSIT_BANK_NAME=
DEPOSIT_ACCOUNT_NAME=
DEPOSIT_CURRENCY=USD
# Multiply a deposit by this to get the USD credit (e.g. 0.0077 if you collect KES)
DEPOSIT_TO_USD_RATE=1

# Secret for the admin endpoints that confirm/reject deposits. Use a long random string.
ADMIN_KEY=
